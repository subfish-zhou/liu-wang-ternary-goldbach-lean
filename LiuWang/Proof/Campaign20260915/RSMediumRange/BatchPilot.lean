theorem batchPilot_bezout :
    (batchPilotRows.map Prod.fst).prod *
       + 1 =
    factorialBase *  := by
  decide +kernel

theorem batchPilot_primes :
    ∀ p ∈ batchPilotRows.map Prod.fst, p.Prime := by
  apply batch_prime_of_coprime_factorial
  · decide +kernel
  · rw [factorialBase_eq]
    exact coprime_of_mul_add_one batchPilot_bezout

theorem batchPilot_logs :
    ∀ r ∈ batchPilotRows,
      2 ^ r.2.1 ≤ r.1 ∧ r.1 < 2 ^ (r.2.1 + 1) ∧
      (FixedBracket.log r.1 r.2.1).lo = r.2.2.1 ∧
      (FixedBracket.log r.1 r.2.1).hi = r.2.2.2 := by
  decide +kernel

theorem batchPilot_log_bounds {r : ℕ × ℕ × ℕ × ℕ}
    (hr : r ∈ batchPilotRows) :
    (FixedBracket.mk r.2.2.1 r.2.2.2).Contains (Real.log r.1) := by
  obtain ⟨hl, hu, hlo, hhi⟩ := batchPilot_logs r hr
  have h := FixedBracket.log_contains hl hu
  simpa only [FixedBracket.Contains, hlo, hhi] using h

#print axioms batchPilot_primes
#print axioms batchPilot_log_bounds

