import LiuWang.Proof.Campaign20260915.RSMediumRange.GridLogCore

set_option autoImplicit false
set_option Elab.async false
set_option maxRecDepth 100000
set_option maxHeartbeats 4000000

namespace LiuWang.Proof.Campaign20260915.RSMediumRange

def gridLogPacked : ℕ :=
  

def gridLogLookup (m : ℕ) : ℕ :=
  gridLogPacked / 2 ^ (64 * (m - 1024)) % 2 ^ 64

theorem gridLogTable_checked :
    ∀ j ∈ Finset.range 1024,
      (FixedBracket.log (j + 1024) 10).lo = gridLogLookup (j + 1024) ∧
      (FixedBracket.log (j + 1024) 10).hi ≤ gridLogLookup (j + 1024) + 600030 := by
  decide +kernel

theorem gridLogLookup_bounds {m : ℕ} (hm : 1024 ≤ m) (hmhi : m < 2048) :
    (FixedBracket.mk (gridLogLookup m) (gridLogLookup m + 600030)).Contains
      (Real.log m) := by
  have h := gridLogTable_checked (m - 1024) (Finset.mem_range.mpr (by omega))
  rw [Nat.sub_add_cancel hm] at h
  have hl := FixedBracket.log_contains (n := m) (k := 10)
    (by norm_num; omega) (by norm_num; omega)
  refine ⟨?_, ?_⟩
  · simpa only [h.1] using hl.1
  · apply hl.2.trans
    apply div_le_div_of_nonneg_right _ (by positivity)
    exact_mod_cast h.2

def gridRowLo (n e : ℕ) : ℕ :=
  gridLogLo n e (n / 2 ^ e) (gridLogLookup (n / 2 ^ e))

def gridRowHi (n e : ℕ) : ℕ :=
  gridLogHi n e (n / 2 ^ e) (gridLogLookup (n / 2 ^ e) + 600030)

theorem gridRow_bounds {n e : ℕ}
    (hm : 1024 ≤ n / 2 ^ e) (hh : n / 2 ^ e < 2048) :
    (FixedBracket.mk (gridRowLo n e) (gridRowHi n e)).Contains (Real.log n) := by
  exact gridLog_bounds (by omega) (Nat.div_mul_le_self n (2 ^ e))
    (gridLogLookup_bounds hm hh)

#print axioms gridRow_bounds

end LiuWang.Proof.Campaign20260915.RSMediumRange
