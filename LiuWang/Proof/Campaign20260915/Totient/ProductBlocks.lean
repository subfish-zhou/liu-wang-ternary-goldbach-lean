private theorem walk_append {a k l U V W : ℕ}
    (h : productWalk a k U V) (ht : productWalk (a + k) l V W) :
    productWalk a (k + l) U W := by
  induction k generalizing a U with
  | zero =>
    have he : U = V := h
    subst V
    simpa only [Nat.add_zero, Nat.zero_add] using ht
  | succ k ih =>
    rw [Nat.succ_add, productWalk]
    refine ⟨h.1, ih h.2 ?_⟩
    simpa only [Nat.add_assoc, Nat.add_left_comm, Nat.add_comm] using ht

